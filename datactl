#!/usr/bin/env bash
# data-services control. Host needs only bash, coreutils and docker; rendering runs in a container.
set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
ENV_FILE=.env
ARCHIVE=
SERVICES=(elasticsearch mongo redis)
declare -A IMAGE_KEY=([elasticsearch]=ELASTIC_IMAGE [mongo]=MONGO_IMAGE [redis]=REDIS_IMAGE)
declare -A ENV

usage() {
  echo "usage: datactl [--env FILE] {configure|pull|preflight|install|status|verify|bundle|load [--archive PATH]}" >&2
  exit 2
}

die() {
  echo "Error: $*" >&2
  exit 1
}

abs() {
  [[ $1 == /* ]] && printf '%s' "$1" || printf '%s/%s' "$ROOT" "$1"
}

read_env() {
  local file=$1 n=0 line key value stripped
  [[ -f $file ]] || die "Missing $file; copy .env.example to $ENV_FILE and configure it"
  while IFS= read -r line || [[ -n $line ]]; do
    n=$((n + 1))
    stripped=${line#"${line%%[![:space:]]*}"}
    [[ -z $stripped || $stripped == \#* ]] && continue
    [[ $stripped == *=* ]] || die "Invalid .env line $n"
    key=${stripped%%=*}
    value=${stripped#*=}
    [[ $key =~ ^[A-Z][A-Z0-9_]*$ ]] || die "Invalid .env key at line $n"
    [[ -v "ENV[$key]" ]] && die "Duplicate .env key: $key"
    if [[ ${#value} -ge 2 && ( $value == \"*\" || $value == \'*\' ) ]]; then
      value=${value:1:${#value}-2}
    fi
    stripped=${value//\$\$/}
    [[ $stripped == *'$'* ]] && die "$key: write \$ as \$\$ (Compose interpolates .env values)"
    ENV[$key]=$value
  done <"$file"
}

need() {
  local value=${ENV[$1]-}
  [[ -n $value && $value != *CHANGE_ME* ]] || die "Configure $1 in $ENV_FILE"
  printf '%s' "$value"
}

boolean() {
  local value=${ENV[$1]-false}
  [[ $value == true || $value == false ]] || die "$1 must be true or false"
  printf '%s' "$value"
}

allowed_host() {
  # Blank ALLOWED_HOSTS disables the allowlist.
  local host=$1 entry list=${ENV[ALLOWED_HOSTS]-}
  [[ -z ${list//[, ]/} ]] && return 0
  IFS=, read -ra entries <<<"$list"
  for entry in "${entries[@]}"; do
    [[ ${entry// /} == "$host" ]] && return 0
  done
  return 1
}

check_image() {
  local image=$1 registry last
  if [[ -n ${ENV[ALLOWED_HOSTS]-} ]]; then
    [[ $image == */* ]] || die "Image registry is not in ALLOWED_HOSTS: $image"
    registry=${image%%/*}
    allowed_host "${registry%%:*}" || die "Image registry is not in ALLOWED_HOSTS: $image"
  fi
  last=${image##*/}
  if [[ $last != *@sha256:* ]]; then
    [[ $last == *:* && $last != *:latest ]] || die "Use a versioned image tag or digest: $image"
  fi
}

ensure_image() {
  # Pull an image from its registry when it is not present locally.
  docker image inspect "$1" >/dev/null 2>&1 && return 0
  echo "Pulling $1"
  docker pull "$1" >/dev/null || die "Could not pull image: $1"
}

all_images() {
  local service
  for service in "${SERVICES[@]}"; do
    need "${IMAGE_KEY[$service]}"
    echo
  done
}

compose() {
  [[ -f $ROOT/generated/compose.env ]] || die "Run configure first"
  docker compose --project-directory "$ROOT" --env-file "$ENV_PATH" --env-file "$ROOT/generated/compose.env" \
    -f "$ROOT/compose.yaml" "$@"
}

stage_private() {
  # Copy each service's secrets (and TLS files when enabled) into generated/private/<service>/ owned by
  # that service's uid with mode 400. Runs as root in the toolbox container; the host operator keeps the originals.
  local toolbox=$1 tls=$2 src=
  if [[ $tls == true ]]; then
    src=$(abs "$(need TLS_DIR)")
    [[ -d $src ]] || die "TLS_DIR not found: $src"
  fi
  mkdir -p "$ROOT/generated/private"
  docker run --rm -v "$ROOT/generated:/generated" ${src:+-v "$src:/src:ro"} -e "TLS=$tls" \
    -e "ES_UID=${ENV[ELASTIC_UID]:-1000}" -e "MONGO_UID=${ENV[MONGO_UID]:-999}" -e "REDIS_UID=${ENV[REDIS_UID]:-999}" \
    "$toolbox" sh -c '
      set -e
      cd /generated
      rm -rf private/elasticsearch private/mongo private/redis
      stage() { # service uid files...
        name=$1; uid=$2; shift 2
        mkdir -p "private/$name"
        for f in "$@"; do cp "$f" "private/$name/"; done
        if [ "$TLS" = true ]; then
          mkdir -p "private/$name/tls"
          cp /src/ca.pem /src/server.crt /src/server.key /src/mongo.pem "private/$name/tls/"
          chmod 500 "private/$name/tls"
        fi
        chown -R "$uid:$uid" "private/$name"
        find "private/$name" -type f -exec chmod 400 {} +
        chmod 500 "private/$name"
      }
      stage elasticsearch "$ES_UID" elastic_password
      stage mongo "$MONGO_UID" mongo_root_username mongo_root_password mongo_credentials
      stage redis "$REDIS_UID" redis_password' || die "Could not stage private files"
}

cmd_configure() {
  local toolbox tls
  toolbox=$(need TOOLBOX_IMAGE)
  check_image "$toolbox"
  ensure_image "$toolbox"
  mkdir -p "$ROOT/generated"
  chmod 700 "$ROOT/generated"
  local -a mounts=(-v "$ENV_PATH:/work/.env:ro" -v "$ROOT/generated:/work/generated" -v "$ROOT/tools:/tools:ro")
  if [[ $(boolean TLS_ENABLED) == true ]]; then
    tls=$(abs "$(need TLS_DIR)")
    [[ -d $tls ]] || die "TLS_DIR not found: $tls"
    mounts+=(-v "$tls:/work/tls:ro")
  fi
  docker run --rm --user "$UID:$(id -g)" -e "HOST_ROOT=$ROOT" "${mounts[@]}" "$toolbox" python3 /tools/render.py /work
  stage_private "$toolbox" "$(boolean TLS_ENABLED)"
}

cmd_pull() {
  local image
  while read -r image; do
    check_image "$image"
    ensure_image "$image"
  done < <(all_images)
}

cmd_preflight() {
  cmd_configure
  (($(<"/proc/sys/vm/max_map_count") >= 262144)) || die "Host vm.max_map_count must be at least 262144 for Elasticsearch"
  cmd_pull
  compose config --quiet
}

cmd_install() {
  cmd_preflight
  compose up -d --no-build --wait --wait-timeout 300
}

cmd_verify() {
  local service
  for service in "${SERVICES[@]}"; do
    [[ $(docker inspect --format '{{.State.Health.Status}}' "data-services-$service-1" 2>/dev/null) == healthy ]] || die "$service is not healthy"
    echo "$service: healthy"
  done
}

cmd_bundle() {
  local -a images=()
  mapfile -t images < <(all_images)
  mkdir -p "$ROOT/dist"
  docker save -o "$ROOT/dist/images.tar" "${images[@]}"
  tar -czf "$ROOT/dist/installer.tar.gz" -C "$ROOT" --exclude='__pycache__' \
    datactl compose.yaml tools init .env.example README.md
  (cd "$ROOT/dist" && sha256sum images.tar installer.tar.gz >checksums.sha256)
  echo "Bundle exported to dist/ without credentials; transfer site configuration separately."
}

cmd_load() {
  local archive=${ARCHIVE:-$ROOT/dist/images.tar} dir
  [[ -f $archive ]] || die "Image archive not found: $archive"
  dir=$(cd "$(dirname "$archive")" && pwd)
  [[ -f $dir/checksums.sha256 ]] || die "checksums.sha256 must sit next to the archive"
  (cd "$dir" && sha256sum -c --ignore-missing --quiet checksums.sha256) || die "Image bundle checksum mismatch"
  docker load -i "$archive"
}

COMMAND=
while (($#)); do
  case $1 in
    --env) [[ $# -ge 2 ]] || usage; ENV_FILE=$2; shift 2 ;;
    --archive) [[ $# -ge 2 ]] || usage; ARCHIVE=$2; shift 2 ;;
    configure | pull | preflight | install | status | verify | bundle | load) [[ -z $COMMAND ]] || usage; COMMAND=$1; shift ;;
    *) usage ;;
  esac
done
[[ -n $COMMAND ]] || usage
ENV_PATH=$(abs "$ENV_FILE")
read_env "$ENV_PATH"
case $COMMAND in
  configure) cmd_configure ;;
  pull) cmd_pull ;;
  preflight) cmd_preflight ;;
  install) cmd_install ;;
  status) compose ps ;;
  verify) cmd_verify ;;
  bundle) cmd_bundle ;;
  load) cmd_load ;;
esac
