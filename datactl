#!/usr/bin/env bash
# data-services control. Host needs only bash, coreutils and docker; rendering runs in a container.
set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
ENV_FILE=.env
ARCHIVE=
SERVICES=(elasticsearch mongo redis)
declare -A IMAGE_KEY=([elasticsearch]=ELASTIC_IMAGE [mongo]=MONGO_IMAGE [redis]=REDIS_IMAGE)
declare -A ENV

usage() {
  echo "usage: datactl [--env FILE] {configure|build|preflight|install|status|verify|bundle|load [--archive PATH]}" >&2
  exit 2
}

die() {
  echo "Error: $*" >&2
  exit 1
}

abs() {
  [[ $1 == /* ]] && printf '%s' "$1" || printf '%s/%s' "$ROOT" "$1"
}

read_env() {
  local file=$1 n=0 line key value stripped
  [[ -f $file ]] || die "Missing $file; copy .env.example to $ENV_FILE and configure it"
  while IFS= read -r line || [[ -n $line ]]; do
    n=$((n + 1))
    stripped=${line#"${line%%[![:space:]]*}"}
    [[ -z $stripped || $stripped == \#* ]] && continue
    [[ $stripped == *=* ]] || die "Invalid .env line $n"
    key=${stripped%%=*}
    value=${stripped#*=}
    [[ $key =~ ^[A-Z][A-Z0-9_]*$ ]] || die "Invalid .env key at line $n"
    [[ -v "ENV[$key]" ]] && die "Duplicate .env key: $key"
    if [[ ${#value} -ge 2 && ( $value == \"*\" || $value == \'*\' ) ]]; then
      value=${value:1:${#value}-2}
    fi
    stripped=${value//\$\$/}
    [[ $stripped == *'$'* ]] && die "$key: write \$ as \$\$ (Compose interpolates .env values)"
    ENV[$key]=$value
  done <"$file"
}

need() {
  local value=${ENV[$1]-}
  [[ -n $value && $value != *CHANGE_ME* ]] || die "Configure $1 in $ENV_FILE"
  printf '%s' "$value"
}

boolean() {
  local value=${ENV[$1]-false}
  [[ $value == true || $value == false ]] || die "$1 must be true or false"
  printf '%s' "$value"
}

allowed_host() {
  local host=$1 entry
  IFS=, read -ra entries <<<"$(need ALLOWED_HOSTS)"
  for entry in "${entries[@]}"; do
    [[ ${entry// /} == "$host" ]] && return 0
  done
  return 1
}

url_host() {
  local rest=${1#*://}
  rest=${rest%%/*}
  printf '%s' "${rest%%:*}"
}

check_image() {
  local image=$1 registry last
  [[ $image == */* ]] || die "Image registry is not in ALLOWED_HOSTS: $image"
  registry=${image%%/*}
  allowed_host "${registry%%:*}" || die "Image registry is not in ALLOWED_HOSTS: $image"
  last=${image##*/}
  if [[ $last != *@sha256:* ]]; then
    [[ $last == *:* && $last != *:latest ]] || die "Use a versioned image tag or digest: $image"
  fi
}

check_repo_file() {
  local file=${ENV[YUM_REPO_FILE]-} sections=0 line key value url
  [[ -n $file ]] || return 0
  file=$(abs "$file")
  [[ -f $file ]] || die "YUM_REPO_FILE not found: $file"
  while IFS= read -r line || [[ -n $line ]]; do
    line=${line#"${line%%[![:space:]]*}"}
    [[ -z $line || $line == \#* ]] && continue
    if [[ $line == \[*\] ]]; then sections=$((sections + 1)); continue; fi
    key=${line%%=*}
    key=${key//[[:space:]]/}
    value=${line#*=}
    case $key in
      mirrorlist | metalink) die "YUM repositories must use explicit baseurl values" ;;
      baseurl | gpgkey)
        for url in $value; do
          [[ $key == gpgkey && $url == file:///* ]] && continue
          [[ $url == http://* || $url == https://* ]] || die "Repository URL must be http(s): $url"
          allowed_host "$(url_host "$url")" || die "Repository host is not in ALLOWED_HOSTS: $(url_host "$url")"
        done ;;
    esac
  done <"$file"
  ((sections > 0)) || die "YUM_REPO_FILE must contain repository definitions"
  printf '%s' "$file"
}

compose() {
  [[ -f $ROOT/generated/compose.env ]] || die "Run configure first"
  docker compose --project-directory "$ROOT" --env-file "$ENV_PATH" --env-file "$ROOT/generated/compose.env" \
    -f "$ROOT/compose.yaml" "$@"
}

cmd_configure() {
  local base tls
  base=$(need RUNTIME_BASE_IMAGE)
  check_image "$base"
  docker image inspect "$base" >/dev/null 2>&1 || die "Base image not present locally: $base"
  mkdir -p "$ROOT/generated"
  chmod 700 "$ROOT/generated"
  local -a mounts=(-v "$ENV_PATH:/work/.env:ro" -v "$ROOT/generated:/work/generated" -v "$ROOT/containers/tools:/tools:ro")
  if [[ $(boolean TLS_ENABLED) == true ]]; then
    tls=$(abs "$(need TLS_DIR)")
    [[ -d $tls ]] || die "TLS_DIR not found: $tls"
    mounts+=(-v "$tls:/work/tls:ro")
  fi
  docker run --rm --user "$UID:$(id -g)" -e "HOST_ROOT=$ROOT" "${mounts[@]}" "$base" python3 /tools/render.py /work
}

cmd_build() {
  local repo ca base service image key
  repo=$(check_repo_file)
  ca=$(abs "$(need CA_BUNDLE)")
  [[ -f $ca ]] || die "CA_BUNDLE must exist; provide your site CA bundle"
  [[ $ca -ef $ROOT/config/ca.pem ]] || cp "$ca" "$ROOT/config/ca.pem"
  base=$(need RUNTIME_BASE_IMAGE)
  check_image "$base"
  docker image inspect "$base" >/dev/null 2>&1 || die "Base image not present locally: $base"
  local -a args=()
  for key in RUNTIME_BASE_IMAGE ELASTIC_PACKAGE MONGO_PACKAGE MONGOSH_PACKAGE REDIS_PACKAGE; do
    args+=(--build-arg "$key=$(need "$key")")
  done
  [[ -n $repo ]] && args+=(--secret "id=yum_repo,src=$repo")
  for service in "${SERVICES[@]}"; do
    image=$(need "${IMAGE_KEY[$service]}")
    check_image "$image"
    docker build --pull=false --network "${ENV[BUILD_NETWORK]:-default}" -f "$ROOT/containers/Containerfile" \
      "${args[@]}" --target "$service" -t "$image" "$ROOT"
  done
}

cmd_preflight() {
  local service
  cmd_configure
  (($(<"/proc/sys/vm/max_map_count") >= 262144)) || die "Host vm.max_map_count must be at least 262144 for Elasticsearch"
  for service in "${SERVICES[@]}"; do
    docker image inspect "$(need "${IMAGE_KEY[$service]}")" >/dev/null 2>&1 || die "Image not present locally: $(need "${IMAGE_KEY[$service]}")"
  done
  compose config --quiet
}

cmd_install() {
  cmd_preflight
  compose up -d --no-build --pull never --wait --wait-timeout 300
}

cmd_verify() {
  local service
  for service in "${SERVICES[@]}"; do
    compose exec -T "$service" /usr/local/bin/health "$service"
    echo "$service: healthy"
  done
}

cmd_bundle() {
  local -a images=()
  local service
  for service in "${SERVICES[@]}"; do images+=("$(need "${IMAGE_KEY[$service]}")"); done
  mkdir -p "$ROOT/dist"
  docker save -o "$ROOT/dist/images.tar" "${images[@]}"
  tar -czf "$ROOT/dist/installer.tar.gz" -C "$ROOT" --exclude='__pycache__' \
    datactl compose.yaml containers .env.example config/yum.repo.example README.md
  (cd "$ROOT/dist" && sha256sum images.tar installer.tar.gz >checksums.sha256)
  echo "Bundle exported to dist/ without credentials; transfer site configuration separately."
}

cmd_load() {
  local archive=${ARCHIVE:-$ROOT/dist/images.tar} dir
  [[ -f $archive ]] || die "Image archive not found: $archive"
  dir=$(cd "$(dirname "$archive")" && pwd)
  [[ -f $dir/checksums.sha256 ]] || die "checksums.sha256 must sit next to the archive"
  (cd "$dir" && sha256sum -c --ignore-missing --quiet checksums.sha256) || die "Image bundle checksum mismatch"
  docker load -i "$archive"
}

COMMAND=
while (($#)); do
  case $1 in
    --env) [[ $# -ge 2 ]] || usage; ENV_FILE=$2; shift 2 ;;
    --archive) [[ $# -ge 2 ]] || usage; ARCHIVE=$2; shift 2 ;;
    configure | build | preflight | install | status | verify | bundle | load) [[ -z $COMMAND ]] || usage; COMMAND=$1; shift ;;
    *) usage ;;
  esac
done
[[ -n $COMMAND ]] || usage
ENV_PATH=$(abs "$ENV_FILE")
read_env "$ENV_PATH"
case $COMMAND in
  configure) cmd_configure ;;
  build) cmd_build ;;
  preflight) cmd_preflight ;;
  install) cmd_install ;;
  status) compose ps ;;
  verify) cmd_verify ;;
  bundle) cmd_bundle ;;
  load) cmd_load ;;
esac
