#!/usr/bin/env bash
# data-services control. Host needs only bash, coreutils and docker; rendering runs in a container.
set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
ENV_FILE=.env
ARCHIVE=
SERVICES=(elasticsearch mongo redis sqlserver)
declare -A IMAGE_KEY=([elasticsearch]=ELASTIC_IMAGE [mongo]=MONGO_IMAGE [redis]=REDIS_IMAGE [sqlserver]=SQLSERVER_FTS_IMAGE)
declare -A ENV

usage() {
  echo "usage: datactl [--env FILE] [--from STEP] {configure|pull|build|preflight|install|verify|status|bundle|load [--archive PATH]}" >&2
  echo "       datactl [--env FILE] mongo-restore --dump PATH [--db NAME] [--to-db NAME] [--drop]" >&2
  echo "chain: configure pull build preflight install verify (each runs every earlier step; --from starts later)" >&2
  exit 2
}

die() {
  echo "Error: $*" >&2
  exit 1
}

abs() {
  [[ $1 == /* ]] && printf '%s' "$1" || printf '%s/%s' "$ROOT" "$1"
}

read_env() {
  local file=$1 n=0 line key value stripped
  [[ -f $file ]] || die "Missing $file; copy .env.example to $ENV_FILE and configure it"
  while IFS= read -r line || [[ -n $line ]]; do
    n=$((n + 1))
    stripped=${line#"${line%%[![:space:]]*}"}
    [[ -z $stripped || $stripped == \#* ]] && continue
    [[ $stripped == *=* ]] || die "Invalid .env line $n"
    key=${stripped%%=*}
    value=${stripped#*=}
    [[ $key =~ ^[A-Z][A-Z0-9_]*$ ]] || die "Invalid .env key at line $n"
    [[ -v "ENV[$key]" ]] && die "Duplicate .env key: $key"
    if [[ ${#value} -ge 2 && ( $value == \"*\" || $value == \'*\' ) ]]; then
      value=${value:1:${#value}-2}
    fi
    stripped=${value//\$\$/}
    [[ $stripped == *'$'* ]] && die "$key: write \$ as \$\$ (Compose interpolates .env values)"
    ENV[$key]=$value
  done <"$file"
}

need() {
  local value=${ENV[$1]-}
  [[ -n $value && $value != *CHANGE_ME* ]] || die "Configure $1 in $ENV_FILE"
  printf '%s' "$value"
}

boolean() {
  local value=${ENV[$1]-false}
  [[ $value == true || $value == false ]] || die "$1 must be true or false"
  printf '%s' "$value"
}

allowed_host() {
  # Blank ALLOWED_HOSTS disables the allowlist.
  local host=$1 entry list=${ENV[ALLOWED_HOSTS]-}
  [[ -z ${list//[, ]/} ]] && return 0
  IFS=, read -ra entries <<<"$list"
  for entry in "${entries[@]}"; do
    [[ ${entry// /} == "$host" ]] && return 0
  done
  return 1
}

check_image() {
  local image=$1 registry last
  if [[ -n ${ENV[ALLOWED_HOSTS]-} ]]; then
    [[ $image == */* ]] || die "Image registry is not in ALLOWED_HOSTS: $image"
    registry=${image%%/*}
    allowed_host "${registry%%:*}" || die "Image registry is not in ALLOWED_HOSTS: $image"
  fi
  last=${image##*/}
  if [[ $last != *@sha256:* ]]; then
    [[ $last == *:* && $last != *:latest ]] || die "Use a versioned image tag or digest: $image"
  fi
}

output_tag() {
  # Locally built images are never pushed; only a versioned tag is required, no registry.
  local last=${1##*/}
  [[ $last == *:* && $last != *:latest ]] || die "Use a versioned tag for the built image: $1"
}

ensure_image() {
  # Pull an image from its registry when it is not present locally. Docker's own layer progress is
  # left on screen: these images run to several gigabytes and silence looks indistinguishable from
  # a hung command.
  docker image inspect "$1" >/dev/null 2>&1 && return 0
  echo "Pulling $1"
  docker pull "$1" || die "Could not pull image: $1"
}

all_images() {
  local service
  for service in "${SERVICES[@]}"; do
    need "${IMAGE_KEY[$service]}"
    echo
  done
}

compose() {
  [[ -f $ROOT/generated/compose.env ]] || die "Run configure first"
  docker compose --project-directory "$ROOT" --env-file "$ENV_PATH" --env-file "$ROOT/generated/compose.env" \
    -f "$ROOT/compose.yaml" "$@"
}

stage_private() {
  # Copy each service's secrets (and TLS files when enabled) into generated/private/<service>/ owned by
  # that service's uid with mode 400. Runs as root in the toolbox container; the host operator keeps the originals.
  local toolbox=$1 tls=$2 src=
  if [[ $tls == true ]]; then
    src=$(abs "$(need TLS_DIR)")
    [[ -d $src ]] || die "TLS_DIR not found: $src"
  fi
  mkdir -p "$ROOT/generated/private"
  docker run --rm -v "$ROOT/generated:/generated" ${src:+-v "$src:/src:ro"} -e "TLS=$tls" \
    -e "ES_UID=${ENV[ELASTIC_UID]:-1000}" -e "MONGO_UID=${ENV[MONGO_UID]:-999}" -e "REDIS_UID=${ENV[REDIS_UID]:-1001}" \
    -e "SQLSERVER_UID=${ENV[SQLSERVER_UID]:-10001}" \
    "$toolbox" sh -c '
      set -e
      cd /generated
      # Overwrite in place: the files are bind-mounted into running containers, so inodes must survive re-staging.
      stage() { # service uid files...
        name=$1; uid=$2; shift 2
        mkdir -p "private/$name/tls"
        chmod 700 "private/$name" "private/$name/tls"
        for f in "$@"; do cp "$f" "private/$name/$f"; done
        if [ "$TLS" = true ]; then
          for f in ca.pem server.crt server.key mongo.pem; do cp "/src/$f" "private/$name/tls/$f"; done
        else
          rm -f "private/$name"/tls/*
        fi
        chmod 500 "private/$name/tls"
        chown -R "$uid:$uid" "private/$name"
        find "private/$name" -type f -exec chmod 400 {} +
        chmod 500 "private/$name"
      }
      stage elasticsearch "$ES_UID" elastic_password
      stage mongo "$MONGO_UID" mongo_root_username mongo_root_password mongo_credentials
      stage redis "$REDIS_UID" redis_password
      stage sqlserver "$SQLSERVER_UID" sqlserver_sa_password sqlserver_password' || die "Could not stage private files"
}

cmd_configure() {
  local toolbox tls
  toolbox=$(need BASE_IMAGE)
  check_image "$toolbox"
  ensure_image "$toolbox"
  mkdir -p "$ROOT/generated"
  chmod 700 "$ROOT/generated"
  local -a mounts=(-v "$ENV_PATH:/work/.env:ro" -v "$ROOT/generated:/work/generated" -v "$ROOT/tools:/tools:ro")
  if [[ $(boolean TLS_ENABLED) == true ]]; then
    tls=$(abs "$(need TLS_DIR)")
    [[ -d $tls ]] || die "TLS_DIR not found: $tls"
    mounts+=(-v "$tls:/work/tls:ro")
  fi
  docker run --rm --user "$UID:$(id -g)" -e "HOST_ROOT=$ROOT" "${mounts[@]}" "$toolbox" python3 /tools/render.py /work
  stage_private "$toolbox" "$(boolean TLS_ENABLED)"
}

proxy_args() {
  # Blank means no proxy; both letter cases because dnf and curl read the lowercase names.
  local key value
  for key in HTTP_PROXY HTTPS_PROXY NO_PROXY; do
    value=${ENV[$key]-}
    [[ -n $value ]] || continue
    printf -- '--build-arg\n%s=%s\n--build-arg\n%s=%s\n' "$key" "$value" "${key,,}" "$value"
  done
}

cmd_pull() {
  # Vendor images only; Redis and SQL Server are built locally. SQLSERVER_IMAGE is the SQL Server
  # build base rather than a service image, so this loops over keys instead of IMAGE_KEY services.
  local key image
  for key in ELASTIC_IMAGE MONGO_IMAGE SQLSERVER_IMAGE; do
    image=$(need "$key")
    check_image "$image"
    ensure_image "$image"
  done
}

cmd_build() {
  local base image
  base=$(need BASE_IMAGE)
  check_image "$base"
  ensure_image "$base"
  image=$(need REDIS_IMAGE)
  output_tag "$image"
  local -a proxy=()
  mapfile -t proxy < <(proxy_args)
  docker build --pull=false --network "${ENV[BUILD_NETWORK]:-default}" -f "$ROOT/containers/Containerfile" \
    --build-arg "BASE_IMAGE=$base" --build-arg "REDIS_PACKAGE=$(need REDIS_PACKAGE)" --build-arg "REDIS_UID=${ENV[REDIS_UID]:-1001}" \
    "${proxy[@]}" -t "$image" "$ROOT/containers"
  # Full-Text Search is not in the vendor SQL Server image; this build adds it.
  local sqlbase sqlimage
  sqlbase=$(need SQLSERVER_IMAGE)
  check_image "$sqlbase"
  ensure_image "$sqlbase"
  sqlimage=$(need SQLSERVER_FTS_IMAGE)
  output_tag "$sqlimage"
  docker build --pull=false --network "${ENV[BUILD_NETWORK]:-default}" -f "$ROOT/containers/sqlserver/Containerfile" \
    --build-arg "SQLSERVER_IMAGE=$sqlbase" "${proxy[@]}" -t "$sqlimage" "$ROOT/containers/sqlserver"
}

cmd_preflight() {
  (($(<"/proc/sys/vm/max_map_count") >= 262144)) || echo "Note: vm.max_map_count is below 262144; Elasticsearch runs without mmap storage"
  docker image inspect "$(need REDIS_IMAGE)" >/dev/null 2>&1 || die "Redis image not built yet: run ./datactl build"
  docker image inspect "$(need SQLSERVER_FTS_IMAGE)" >/dev/null 2>&1 || die "SQL Server image not built yet: run ./datactl build"
  local mem_kb
  mem_kb=$(awk '/^MemTotal:/ {print $2}' /proc/meminfo)
  ((mem_kb >= 2000000)) || echo "Note: host memory is below 2 GB; SQL Server refuses to start"
  compose config --quiet
}

cmd_install() {
  # 600s, not 300: SQL Server's first start waits out "script upgrade mode" and applies its init
  # scripts before the healthcheck can pass.
  compose up -d --no-build --wait --wait-timeout 600
}

cmd_verify() {
  local service
  for service in "${SERVICES[@]}"; do
    [[ $(docker inspect --format '{{.State.Health.Status}}' "data-services-$service-1" 2>/dev/null) == healthy ]] || die "$service is not healthy"
    echo "$service: healthy"
  done
  local installed
  installed=$(docker exec data-services-sqlserver-1 sh -c \
    "/opt/mssql-tools18/bin/sqlcmd -C -b -S localhost -U sa -P \"\$(cat /run/secrets/sqlserver_sa_password)\" \
     -h -1 -W -Q \"SET NOCOUNT ON; SELECT CAST(SERVERPROPERTY('IsFullTextInstalled') AS INT)\"" 2>/dev/null |
    head -n1 | tr -d '[:space:]')
  [[ $installed == 1 ]] || die "SQL Server has no full-text search (IsFullTextInstalled=$installed): run ./datactl build"
  echo "sqlserver: full-text search installed"
}

cmd_bundle() {
  local -a images=()
  mapfile -t images < <(all_images)
  mkdir -p "$ROOT/dist"
  # docker save, tar and sha256sum are all silent and all slow at this size (the SQL Server image
  # alone is several GB), so name each step instead of leaving the operator guessing.
  echo "Saving ${#images[@]} images to dist/images.tar (this takes a few minutes)"
  docker save -o "$ROOT/dist/images.tar" "${images[@]}"
  echo "Packing dist/installer.tar.gz"
  tar -czf "$ROOT/dist/installer.tar.gz" -C "$ROOT" --exclude='__pycache__' \
    datactl compose.yaml containers tools init .env.example README.md
  echo "Checksumming dist/"
  (cd "$ROOT/dist" && sha256sum images.tar installer.tar.gz >checksums.sha256)
  echo "Bundle exported to dist/ without credentials; transfer site configuration separately."
}

cmd_mongo_restore() {
  # Restore a mongodump (directory or --archive file) into the running MongoDB as the admin user.
  local dump=$1 db=$2 to_db=$3 drop=$4 container=data-services-mongo-1 name tls= args=()
  [[ -n $dump ]] || die "mongo-restore needs --dump PATH (mongodump directory or archive file)"
  [[ -e $dump ]] || die "Dump not found: $dump"
  [[ $(docker inspect --format '{{.State.Health.Status}}' "$container" 2>/dev/null) == healthy ]] || die "MongoDB container is not healthy"
  [[ $(boolean TLS_ENABLED) == true ]] && tls="--ssl --sslCAFile /tls/ca.pem"  # database tools use the ssl spelling
  name=$(basename "$dump")
  docker exec "$container" sh -c 'rm -rf /tmp/restore && mkdir -p /tmp/restore'
  docker cp "$dump" "$container:/tmp/restore/$name"
  if [[ -f $dump ]]; then
    args+=("--archive=/tmp/restore/$name")
    [[ $name == *.gz ]] && args+=(--gzip)
  else
    args+=("/tmp/restore/$name")
  fi
  if [[ -n $db && -n $to_db ]]; then
    args+=(--nsInclude "$db.*" --nsFrom "$db.*" --nsTo "$to_db.*")
  elif [[ -n $db ]]; then
    args+=(--nsInclude "$db.*")
  elif [[ -n $to_db ]]; then
    die "--to-db needs --db (the database name inside the dump)"
  fi
  [[ $drop == true ]] && args+=(--drop)
  # shellcheck disable=SC2016
  docker exec "$container" sh -c 'mongorestore --host 127.0.0.1 '"$tls"' -u "$(cat /run/secrets/mongo_root_username)" -p "$(cat /run/secrets/mongo_root_password)" --authenticationDatabase admin "$@"' sh "${args[@]}"
  local rc=$?
  docker exec "$container" rm -rf /tmp/restore
  ((rc == 0)) || die "mongorestore failed"
  echo "Restore finished${db:+ (database $db${to_db:+ -> $to_db})}"
}

cmd_load() {
  local archive=${ARCHIVE:-$ROOT/dist/images.tar} dir
  [[ -f $archive ]] || die "Image archive not found: $archive"
  dir=$(cd "$(dirname "$archive")" && pwd)
  [[ -f $dir/checksums.sha256 ]] || die "checksums.sha256 must sit next to the archive"
  (cd "$dir" && sha256sum -c --ignore-missing --quiet checksums.sha256) || die "Image bundle checksum mismatch"
  docker load -i "$archive"
}

CHAIN=(configure pull build preflight install verify)
COMMAND=
FROM=
DUMP= DB= TO_DB= DROP=false
while (($#)); do
  case $1 in
    --env) [[ $# -ge 2 ]] || usage; ENV_FILE=$2; shift 2 ;;
    --from) [[ $# -ge 2 ]] || usage; FROM=$2; shift 2 ;;
    --archive) [[ $# -ge 2 ]] || usage; ARCHIVE=$2; shift 2 ;;
    --dump) [[ $# -ge 2 ]] || usage; DUMP=$2; shift 2 ;;
    --db) [[ $# -ge 2 ]] || usage; DB=$2; shift 2 ;;
    --to-db) [[ $# -ge 2 ]] || usage; TO_DB=$2; shift 2 ;;
    --drop) DROP=true; shift ;;
    configure | pull | build | preflight | install | verify | status | bundle | load | mongo-restore) [[ -z $COMMAND ]] || usage; COMMAND=$1; shift ;;
    *) usage ;;
  esac
done
[[ -n $COMMAND ]] || usage
ENV_PATH=$(abs "$ENV_FILE")
read_env "$ENV_PATH"
chain_index() { local i; for i in "${!CHAIN[@]}"; do [[ ${CHAIN[$i]} == "$1" ]] && { echo "$i"; return; }; done; return 1; }
case $COMMAND in
  status) compose ps ;;
  bundle) cmd_bundle ;;
  load) cmd_load ;;
  mongo-restore) cmd_mongo_restore "$DUMP" "$DB" "$TO_DB" "$DROP" ;;
  *)
    last=$(chain_index "$COMMAND")
    first=0
    if [[ -n $FROM ]]; then first=$(chain_index "$FROM") || die "--from must be one of: ${CHAIN[*]}"; fi
    ((first <= last)) || die "--from $FROM comes after $COMMAND"
    for step in "${CHAIN[@]:first:last-first+1}"; do
      echo "==> $step"
      "cmd_$step"
    done ;;
esac
