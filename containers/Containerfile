# Redis from the RPM repositories baked into the base image. MongoDB and Elasticsearch use vendor images.
ARG REDIS_BASE_IMAGE
FROM ${REDIS_BASE_IMAGE}
ARG REDIS_PACKAGE=redis
ARG REDIS_UID=1001
# Fixed uid so staged secrets and TLS files (owned by REDIS_UID) are readable; the RPM reuses the existing user.
RUN groupadd -g "${REDIS_UID}" redis && useradd -u "${REDIS_UID}" -g redis -r -d /var/lib/redis -s /sbin/nologin redis && \
    if command -v dnf >/dev/null; then dnf -y install ${REDIS_PACKAGE} && dnf clean all; else microdnf -y install ${REDIS_PACKAGE} && microdnf clean all; fi && \
    mkdir -p /data && chown "${REDIS_UID}:${REDIS_UID}" /data && redis-server --version
USER ${REDIS_UID}
VOLUME /data
CMD ["redis-server", "/run/config/redis.conf"]
