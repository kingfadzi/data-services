ARG RUNTIME_BASE_IMAGE
FROM ${RUNTIME_BASE_IMAGE} AS base
USER root
COPY config/tls-ca-bundle.zip /tmp/tls-ca-bundle.zip
COPY containers/install-trust.sh /tmp/install-trust.sh
COPY containers/install-rpms.sh /tmp/install-rpms.sh
RUN sh /tmp/install-trust.sh && rm -f /tmp/tls-ca-bundle.zip /tmp/install-trust.sh
RUN sh /tmp/install-rpms.sh shadow-utils util-linux-core procps-ng

FROM base AS elasticsearch
ARG ELASTIC_PACKAGE
# The RPM forces ES_PATH_CONF=/etc/elasticsearch via /etc/sysconfig; its install-time auto-configuration is removed.
ENV ES_PATH_CONF=/etc/elasticsearch ES_JAVA_OPTS="-Xms1g -Xmx1g"
RUN sh /tmp/install-rpms.sh "$ELASTIC_PACKAGE" && \
    rm -rf /etc/elasticsearch/certs /etc/elasticsearch/elasticsearch.keystore /etc/elasticsearch/elasticsearch.yml && \
    mkdir -p /usr/share/elasticsearch/data /usr/share/elasticsearch/logs && \
    chown -R elasticsearch:elasticsearch /usr/share/elasticsearch /etc/elasticsearch
COPY containers/elastic-entrypoint.sh /usr/local/bin/start-elastic
COPY containers/health.sh /usr/local/bin/health
RUN chmod +x /usr/local/bin/start-elastic /usr/local/bin/health
ENTRYPOINT ["/usr/local/bin/start-elastic"]

FROM base AS mongo
ARG MONGO_PACKAGE
ARG MONGOSH_PACKAGE
RUN sh /tmp/install-rpms.sh "$MONGO_PACKAGE" "$MONGOSH_PACKAGE" && mkdir -p /data/db
COPY containers/mongo-entrypoint.sh /usr/local/bin/start-mongo
COPY containers/mongo-init.js /usr/local/lib/mongo-init.js
COPY containers/health.sh /usr/local/bin/health
RUN chmod +x /usr/local/bin/start-mongo /usr/local/bin/health
ENTRYPOINT ["/usr/local/bin/start-mongo"]

FROM base AS redis
ARG REDIS_PACKAGE
RUN sh /tmp/install-rpms.sh "$REDIS_PACKAGE" && mkdir -p /data
COPY containers/redis-entrypoint.sh /usr/local/bin/start-redis
COPY containers/health.sh /usr/local/bin/health
RUN chmod +x /usr/local/bin/start-redis /usr/local/bin/health
ENTRYPOINT ["/usr/local/bin/start-redis"]
