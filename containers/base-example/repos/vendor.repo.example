# Copy to vendor.repo and point every baseurl/gpgkey at your mirror.
[elasticsearch]
name=Elasticsearch 8.x
baseurl=https://yum.example.com/repository/elastic-8.x/
enabled=1
gpgcheck=1
gpgkey=https://yum.example.com/repository/keys/GPG-KEY-elasticsearch

[mongodb-org-8.0]
name=MongoDB 8.0
baseurl=https://yum.example.com/repository/mongodb-8.0/$basearch/
enabled=1
gpgcheck=1
gpgkey=https://yum.example.com/repository/keys/server-8.0.asc

[remi-modular]
name=Remi modular EL9
baseurl=https://yum.example.com/repository/remi-modular/$basearch/
enabled=1
gpgcheck=1
gpgkey=https://yum.example.com/repository/keys/RPM-GPG-KEY-remi2023 https://yum.example.com/repository/keys/RPM-GPG-KEY-remi2021

[remi-safe]
name=Remi safe EL9
baseurl=https://yum.example.com/repository/remi-safe/$basearch/
enabled=1
gpgcheck=1
gpgkey=https://yum.example.com/repository/keys/RPM-GPG-KEY-remi2023 https://yum.example.com/repository/keys/RPM-GPG-KEY-remi2021
