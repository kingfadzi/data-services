# Official vendor images, pulled when not present locally. Point at your registry (Nexus) or the public registries.
ELASTIC_IMAGE=registry.example.com/elasticsearch/elasticsearch:8.17.2
MONGO_IMAGE=registry.example.com/library/mongo:8.0.11
# The blessed EL9 base image: toolbox for rendering, and the base of the locally built Redis image.
BASE_IMAGE=registry.example.com/mirror/almalinux:9
# Redis is built by `datactl build` from the RPM in BASE_IMAGE's repositories (unpinned). REDIS_IMAGE is the output tag.
REDIS_PACKAGE=redis
REDIS_IMAGE=data-services/redis:el9-1
# SQL Server: the vendor image is the build base. Full-Text Search is not in it, so `datactl build`
# installs mssql-server-fts from packages.microsoft.com and tags the result SQLSERVER_FTS_IMAGE (the
# output tag, never pushed). On a restricted network SQLSERVER_IMAGE must supply the trust that
# install needs: your proxy settings and private CA, as lean-infrastructure's trusted base does.
# Prefer a pinned CU tag such as 2022-CU20-ubuntu-22.04 over the floating 2022-latest.
SQLSERVER_IMAGE=mcr.microsoft.com/mssql/server:2022-latest
SQLSERVER_FTS_IMAGE=data-services/sqlserver:2022-fts-1
# Proxy for build-time package downloads (Redis RPMs, SQL Server debs). Blank means no proxy.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=
BUILD_NETWORK=default
# Optional allowlist of image registries. Exact hostnames, comma separated; blank disables the check.
ALLOWED_HOSTS=
BIND_ADDRESS=0.0.0.0
ELASTIC_PORT=9200
MONGO_PORT=27017
REDIS_PORT=6379
SQLSERVER_PORT=1433
DATA_HOST=CHANGE_ME
ELASTIC_HEAP=1g
# MSSQL_PID: Developer, Express, Standard, Enterprise or a product key. Developer is free, non-production.
SQLSERVER_EDITION=Developer
# mssql-conf memory.memorylimitmb. SQL Server needs roughly 2 GB to start at all.
SQLSERVER_MEMORY_LIMIT_MB=2048
# Database and login created by the SQL Server init scripts, with a default full-text catalog.
SQLSERVER_DB=appdb
SQLSERVER_USERNAME=app
# Empty credentials are generated once by configure and retained in generated/credentials.json.
ELASTIC_PASSWORD=
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=
MONGO_USERNAME=clearml
MONGO_PASSWORD=
REDIS_PASSWORD=
# SQL Server rejects passwords that do not mix upper case, lower case and digits.
SQLSERVER_SA_PASSWORD=
SQLSERVER_PASSWORD=
# TLS is all-or-nothing for this simple stack; supply files before configure/install.
TLS_ENABLED=false
TLS_DIR=config/tls
# Service users inside the images (official images: elasticsearch 1000, mongo 999, sqlserver 10001; the Redis build creates its user as REDIS_UID, which must be free in the base image). Secrets and TLS files are staged with this ownership.
ELASTIC_UID=1000
MONGO_UID=999
REDIS_UID=1001
SQLSERVER_UID=10001
