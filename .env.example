RUNTIME_BASE_IMAGE=registry.example.com/mirror/almalinux:9
# Optional allowlist of image registries. Exact hostnames, comma separated; blank disables the check.
ALLOWED_HOSTS=registry.example.com
# Proxy for build-time RPM downloads. Blank means no proxy.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=
CA_BUNDLE=config/ca.pem
BUILD_NETWORK=default
ELASTIC_IMAGE=registry.example.com/data-services/elasticsearch:8.19.9-el9
MONGO_IMAGE=registry.example.com/data-services/mongodb:8.0.15-el9
REDIS_IMAGE=registry.example.com/data-services/redis:8.2.3-el9
# Exact RPM specs; the base image must carry the vendor repositories (see containers/base-example).
ELASTIC_PACKAGE=elasticsearch-8.19.9
MONGO_PACKAGE=mongodb-org-server-8.0.15
MONGOSH_PACKAGE=mongodb-mongosh-2.5.8
REDIS_PACKAGE=redis-8.2.3
BIND_ADDRESS=0.0.0.0
ELASTIC_PORT=9200
MONGO_PORT=27017
REDIS_PORT=6379
DATA_HOST=data-host
ELASTIC_HEAP=1g
# Empty credentials are generated once by configure and retained in generated/credentials.json.
ELASTIC_PASSWORD=
MONGO_USERNAME=clearml
MONGO_PASSWORD=
REDIS_PASSWORD=
# TLS is all-or-nothing for this simple stack; supply files before configure/install.
TLS_ENABLED=false
TLS_DIR=config/tls
