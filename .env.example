# Official vendor images, pulled when not present locally. Point at your registry (Nexus) or the public registries.
ELASTIC_IMAGE=registry.example.com/elasticsearch/elasticsearch:8.17.2
MONGO_IMAGE=registry.example.com/library/mongo:8.0.11
# Redis is built locally by `datactl build` from the RPM in REDIS_BASE_IMAGE's repositories. REDIS_IMAGE is the output tag.
REDIS_BASE_IMAGE=registry.example.com/mirror/almalinux:9
REDIS_PACKAGE=redis
REDIS_IMAGE=registry.example.com/data-services/redis:el9-1
# Proxy for build-time RPM downloads. Blank means no proxy.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=
BUILD_NETWORK=default
# Any image with python3 and sh; used to render configuration and stage TLS files.
TOOLBOX_IMAGE=registry.example.com/mirror/almalinux:9
# Optional allowlist of image registries. Exact hostnames, comma separated; blank disables the check.
ALLOWED_HOSTS=
BIND_ADDRESS=0.0.0.0
ELASTIC_PORT=9200
MONGO_PORT=27017
REDIS_PORT=6379
DATA_HOST=data-host
ELASTIC_HEAP=1g
# Empty credentials are generated once by configure and retained in generated/credentials.json.
ELASTIC_PASSWORD=
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=
MONGO_USERNAME=clearml
MONGO_PASSWORD=
REDIS_PASSWORD=
# TLS is all-or-nothing for this simple stack; supply files before configure/install.
TLS_ENABLED=false
TLS_DIR=config/tls
# Service users inside the images (official images: elasticsearch 1000, mongo 999; the Redis build creates its user as REDIS_UID, which must be free in the base image). Secrets and TLS files are staged with this ownership.
ELASTIC_UID=1000
MONGO_UID=999
REDIS_UID=1001
